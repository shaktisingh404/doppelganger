GROQ_API_KEY=

# One model per LLM-calling tier — swap independently for cost/quality.
ARCHETYPE_MODEL=qwen/qwen3.6-27b
DELTA_MODEL=qwen/qwen3.6-27b
CHAT_MODEL=qwen/qwen3.6-27b

# Chat replies are phone-call length, not essays -- these are the hard
# backstop behind the common template's "1-2 sentences per turn" prompt.
CHAT_MAX_TOKENS=150
CHAT_TEMPERATURE=0.4

DATABASE_URL=postgresql://user@localhost:5432/doppelganger
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
